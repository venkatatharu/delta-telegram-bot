# ─────────────────────────────────────────────────────────────
# Delta Exchange — Telegram Trading Bot (delta_telegram_bot.py)
# ─────────────────────────────────────────────────────────────
# Delta Exchange India API credentials.
# Create keys at https://india.delta.exchange → API Management.
# Enable Read + Trading permissions. NEVER enable Withdrawal.
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Telegram: bot token from @BotFather. TELEGRAM_OWNER_ID is the numeric
# Telegram user id (from @userinfobot) allowed to drive the bot — everyone
# else is ignored.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# Feature 1 — Testnet toggle. Leave true unless you are ready for real money.
# true  -> https://cdn-ind.testnet.deltaex.org
# false -> https://api.india.delta.exchange
USE_TESTNET=true
# Optional explicit override of the base URL (wins over USE_TESTNET):
#DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# Daily-loss circuit breaker (USDT). New orders are refused once exceeded.
MAX_DAILY_LOSS_USDT=100

# Margin guard: block any new trade whose estimated initial margin exceeds the
# available USDT in your FNO (futures) wallet. Set false to disable.
ENFORCE_MARGIN_LIMIT=true
# Fraction of available USDT you allow to be used (0.9 keeps a 10% buffer).
MARGIN_USAGE_LIMIT=1.0

# How often (seconds) to poll get_positions() for TP-leg fills / closes (Feature 5).
POSITION_POLL_SECONDS=20

# Optional file locations (defaults shown):
#DELTA_STATE_FILE=delta_bot_state.json
#DELTA_JOURNAL_FILE=trade_journal.csv

# Feature 8 — TradingView webhook intake (opt-in). Requires `pip install flask`.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Optional shared secret TradingView must send as "secret" in the alert JSON:
#WEBHOOK_SECRET=change_me

# Extra safety: set ACK_LIVE=1 to let the bot start against the LIVE endpoint
# without the interactive "type LIVE" prompt.
#ACK_LIVE=1
